# Copie este archivo como .env y complete lo que vaya a usar. Todo lo marcado (opcional) puede quedar vacío.

# --- Telegram (obligatorio para el bot): hable con @BotFather en Telegram, /newbot, y pegue el token
TELEGRAM_TOKEN=

# --- IA gratuita (opcional pero recomendada): una sola clave de Groq sirve para entender audios (Whisper)
#     y para el modo híbrido (LLM). Créela gratis, sin tarjeta, en https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODELO=llama-3.3-70b-versatile
#   Alternativa con Gemini (plan gratuito de Google AI Studio):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODELO=gemini-3.1-flash-lite   (verifique el nombre vigente en AI Studio)

# --- Voz a texto: auto = usa la API si hay clave; si no, faster-whisper local si está instalado
STT_MODO=auto
STT_MODELO=whisper-large-v3-turbo
# STT_API_KEY=            (opcional: si quiere una clave distinta a LLM_API_KEY)
# STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODELO_LOCAL=small

# --- Texto a voz (gratis): edge | gtts | ninguno
TTS_MODO=edge
TTS_VOZ=es-CO-SalomeNeural
TTS_VELOCIDAD=-10%
# siempre = responde también con audio | espejo = responde con audio si le hablaron con audio | nunca
RESPONDER_VOZ=espejo
MOSTRAR_TRANSCRIPCION=true

# --- Comportamiento
IPS_NOMBRE=la IPS piloto
MODO_DEMO=true
# LINEA_ATENCION=604 000 0000   (cuando MODO_DEMO=false, se da este número al pedir una persona)
VERIFICAR_NACIMIENTO=false
MINUTOS_SESION=30
# FECHA_SIMULADA=2026-11-12T09:00   (para demos: hace como si hoy fuera esa fecha)

# --- WhatsApp (opcional; desde oct-2026 Meta cobra las respuestas y exige método de pago)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=magnolia-verifica
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
